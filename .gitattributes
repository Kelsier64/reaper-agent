# text files stay LF in the working copy (Lua, PowerShell, Node and REAPER all accept LF)
* text=auto eol=lf

# renders and audio go to Git LFS
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# REAPER project files are text, but never auto-merge them: two agents' edits would corrupt the project
*.rpp -text -merge -diff linguist-language=Text
